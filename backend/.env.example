# ─── Servidor ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# URL pública del backend (se usa para construir las URLs de las imágenes subidas)
PUBLIC_URL=http://localhost:4000
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
# Nº de proxies delante del backend (0 en local, 1 detrás de nginx/Render/Railway, etc.)
TRUST_PROXY=0

# ─── Base de datos ──────────────────────────────────────────
# Coincide con el servicio "db" de docker-compose.yml (puerto 5433 para no chocar con un Postgres local)
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public

# ─── Contenido ──────────────────────────────────────────────
# Carpeta con tus proyectos (un subdirectorio por proyecto). Se carga con: npm run projects:sync
CONTENT_DIR=content/projects

# ─── Storage ────────────────────────────────────────────────
# Dónde se publican las imágenes de los proyectos. "local" = disco del servidor.
# Para escalar horizontalmente implementa un driver S3/R2 en src/lib/storage y cámbialo aquí.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
