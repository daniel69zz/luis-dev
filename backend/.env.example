# ─── Servidor ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# URL pública del backend (se usa para construir las URLs de las imágenes de los proyectos)
PUBLIC_URL=http://localhost:4000
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
# Nº de proxies delante del backend (0 en local, 1 detrás de nginx/Render/Railway, etc.)
TRUST_PROXY=0

# ─── Contenido ──────────────────────────────────────────────
# Carpeta con tus proyectos (un subdirectorio por proyecto). Se lee al arrancar el servidor.
CONTENT_DIR=content/projects
